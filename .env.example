# Copy this file to .env and fill in real values. .env is gitignored.
# NEVER commit a filled-in .env, and never paste these values into chat,
# issues, or logs.

# --- Which banner/store you're shopping at ---
# One of: superstore | loblaws | nofrills | zehrs | independent | tandt
PCEXPRESS_BANNER=superstore
# 4-digit store id, e.g. 1531. Find it once via the store locator on the
# banner's website (e.g. https://www.realcanadiansuperstore.ca/store-locator)
# and reuse it here / via set_active_store.
PCEXPRESS_STORE_ID=

# --- PC ID OAuth app identity (Android app credentials) ---
# These identify the PC Express Android app (not you) to the PC ID login
# server. Both already have working defaults baked into config.py -- see
# README "Why the OAuth client id/secret are baked into config.py". You
# only need to set these if Loblaw rotates the app's credentials and you've
# obtained new values.
PCEXPRESS_CLIENT_ID=
PCEXPRESS_CLIENT_SECRET=

# --- One-time bootstrap ---
# After running `python scripts/login.py` once, the resulting refresh token
# is written to the local state file (see PCEXPRESS_STATE_DIR) and rotated
# automatically from then on -- you should NOT need to keep a refresh token
# in this .env long-term. This var only matters for the very first run if
# you'd rather inject it via env than let login.py write the state file.
PCEXPRESS_REFRESH_TOKEN=

# Directory where rotating tokens + active store/cart state are persisted.
# Must be writable and should NOT be inside a git-tracked directory other
# than via the .gitignore rule already in this repo.
PCEXPRESS_STATE_DIR=~/.pcexpress-mcp

# --- HTTP mode only (remote/mobile access -- see README "Remote/mobile access") ---
# Not needed at all for the default stdio mode (Claude Desktop / Claude Code).

# Your server's public https:// origin, no trailing slash. Required to
# start --http mode; used to build correct OAuth discovery metadata.
PCEXPRESS_PUBLIC_URL=

# Required to start --http mode. Generate with:
#   python scripts/generate_secret.py
# This single value encrypts every connecting tenant's PC Express
# credentials into the OAuth tokens this server hands them -- HTTP mode
# keeps no per-tenant files on disk at all (see pc_express_mcp/token_crypto.py).
# Treat it like any other server secret: never commit it, never share it.
# Rotating it invalidates every currently-issued token at once (everyone
# has to reconnect).
PCEXPRESS_TOKEN_SECRET=

# No account needs to be pre-configured here -- HTTP mode is open
# self-service multi-tenant: whoever you (or anyone else) types into
# Claude's "Add custom connector" > Advanced settings > OAuth Client ID
# field, /authorize verifies via a real PC ID login before issuing that
# person their own token. See README "Remote/mobile access" for what that
# means and the risk tradeoffs before turning this on.

# --- docker-compose.yml only (Caddy's automatic HTTPS) ---
# The bare domain (no https://, no trailing slash) Caddy should request a
# certificate for and reverse-proxy to this server -- should match the host
# part of PCEXPRESS_PUBLIC_URL above. Not read by the Python app itself.
PCEXPRESS_DOMAIN=
